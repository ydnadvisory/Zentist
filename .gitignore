# Python .gitignore
# Based on the canonical GitHub Python template:
# https://github.com/github/gitignore/blob/main/Python.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
# Usually these files are written by a Python script from a template before
# PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py.cover
*.lcov
.hypothesis/
.pytest_cache/
cover/
junit.xml
test-results/

# Type checkers and linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.vulture_whitelist.py

# Translations
*.mo
*.pot

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Flask
instance/
.webassets-cache

# Scrapy
.scrapy

# Sphinx and MkDocs documentation
docs/_build/
/site/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook / IPython
.ipynb_checkpoints/
profile_default/
ipython_config.py

# pyenv
# For libraries/packages, .python-version is often not checked in because the
# code is intended to run in multiple environments. Uncomment if that fits.
# .python-version

# pipenv
# Pipfile.lock is usually committed for applications and may be ignored for
# libraries with platform-specific dependency constraints.
# Pipfile.lock

# uv
# uv.lock is usually committed for applications and may be ignored for libraries.
# uv.lock

# Poetry
# poetry.lock is usually committed for applications and may be ignored for
# libraries. poetry.toml can contain local-only settings.
# poetry.lock
# poetry.toml

# PDM
# pdm.lock is usually committed for applications and may be ignored for
# libraries. pdm.toml can contain project-wide configuration.
# pdm.lock
# pdm.toml
.pdm-python
.pdm-build/

# Pixi
# pixi.lock is usually committed for applications and may be ignored for
# libraries. Keep project config while ignoring the generated environment.
# pixi.lock
.pixi/*
!.pixi/config.toml

# PEP 582
__pypackages__/

# Conda / virtual environments
.conda/
.env
.env.*
!.env.example
!.env.sample
.envrc
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
virtualenv/

# Local secrets and credentials
*.pem
*.key
*.cert
*.crt
.pypirc

# Celery
celerybeat-schedule*
celerybeat.pid

# Redis
*.rdb
*.aof
*.pid

# RabbitMQ
mnesia/
rabbitmq/
rabbitmq-data/

# ActiveMQ
activemq-data/

# SageMath parsed files
*.sage.py

# Cython debug symbols
cython_debug/

# Spyder / Rope
.spyderproject
.spyproject
.ropeproject

# Abstra
.abstra/

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml

# Temporary files from common editors/runners
tempCodeRunnerFile.py
*.tmp
*.temp
*.swp
*.swo
*.png
*~

# IDEs and editors
# Uncomment if the project decides not to commit shared editor settings.
# .idea/
.vscode/
.project
.pydevproject

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.docs
.claude
AGENTS.md
